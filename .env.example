# --- LLM provider (any OpenAI-compatible endpoint: Groq, Ollama, OpenAI, together.ai, ...) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Fallback LLM — used automatically if the primary call errors out ---
# Local Ollama running Qwen3 8B: install Ollama, then `ollama pull qwen3:8b`.
# Leave FALLBACK_LLM_BASE_URL blank to disable fallback entirely.
FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
FALLBACK_LLM_API_KEY=ollama
FALLBACK_LLM_MODEL=qwen3:8b

# --- Web search (Tavily by default) ---
TAVILY_API_KEY=

# --- Contact enrichment provider (Apollo, Hunter, ...) ---
ENRICHMENT_PROVIDER=apollo
ENRICHMENT_BASE_URL=
ENRICHMENT_AUTH_HEADER=X-Api-Key
ENRICHMENT_API_KEY=

# --- Database ---
DB_PATH=./leads.db

# --- Sending ---
MAX_PER_RUN=20
# Path to a PDF (or any file) attached to every outgoing email, if present.
RESUME_ATTACHMENT_PATH=resume.pdf
