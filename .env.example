# --- LLM provider (any OpenAI-compatible endpoint: Groq, Ollama, OpenAI, together.ai, ...) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Web search (Tavily by default) ---
TAVILY_API_KEY=

# --- Contact enrichment provider (Apollo, Hunter, ...) ---
ENRICHMENT_PROVIDER=apollo
ENRICHMENT_BASE_URL=
ENRICHMENT_AUTH_HEADER=X-Api-Key
ENRICHMENT_API_KEY=

# --- Database ---
DB_PATH=./leads.db

# --- Sending ---
MAX_PER_RUN=20
