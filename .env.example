# --- LLM provider (any OpenAI-compatible endpoint: Ollama, Groq, OpenAI, together.ai, ...) ---
# Local Ollama running Qwen3 8B: install Ollama, then `ollama pull qwen3:8b`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# --- Web search (Tavily by default) — company research only, not people ---
TAVILY_API_KEY=
# How far back search results may be: day | week | month | year.
SEARCH_TIME_RANGE=year

# --- Contact enrichment provider (Apollo, Hunter, ...) ---
# People-finding also goes through here: /mixed_people/api_search (0 credits)
# to discover candidates, /people/match with reveal_personal_emails (1 credit)
# to reveal an actual email. Base URL below is Apollo's.
ENRICHMENT_PROVIDER=apollo
ENRICHMENT_BASE_URL=https://api.apollo.io/api/v1
ENRICHMENT_AUTH_HEADER=x-api-key
ENRICHMENT_API_KEY=
# Comma-separated job titles find_contacts() searches for at each company.
APOLLO_SEARCH_TITLES=recruiter,technical recruiter,university recruiter,talent acquisition,engineering manager
# How many of those candidates per company get their email revealed
# (= Apollo credits spent per company per run).
MAX_VERIFY_PER_COMPANY=1

# --- Database ---
DB_PATH=./leads.db

# --- Sending ---
MAX_PER_RUN=20
# Path to a PDF (or any file) attached to every outgoing email, if present.
RESUME_ATTACHMENT_PATH=resume.pdf
